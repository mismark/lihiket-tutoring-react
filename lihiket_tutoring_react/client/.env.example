# ─────────────────────────────────────────────────────────────────────────────
# Client Environment Variables
# Copy to .env and fill in values
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# API URL — points to your deployed backend
# Development (Vite proxy handles this, leave as-is):
VITE_API_URL=/api

# Production (set to your actual backend URL):
# VITE_API_URL=https://lihiket-api.onrender.com/api
