        { "name": "Toggle User Active", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{base_url}}/users/{{userId}}/toggle-active", "host": ["{{base_url}}"], "path": ["users","{{userId}}","toggle-active"] } } },
