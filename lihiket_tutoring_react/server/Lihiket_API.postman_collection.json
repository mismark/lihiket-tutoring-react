          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{base_url}}/auth/verify-otp", "host": ["{{base_url}}"], "path": ["auth","verify-otp"] }, "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@lihiket.com\",\n  \"otp\": \"123456\"\n}" } }
