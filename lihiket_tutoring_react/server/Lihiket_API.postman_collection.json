          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth","login"] }, "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@lihiket.com\",\n  \"password\": \"Admin@12345\"\n}" } }
        },
        {
          "name": "Login as Teacher",
          "event": [{ "listen": "test", "script": { "exec": ["if(pm.response.code===200){pm.collectionVariables.set('token',pm.response.json().data.token);}"], "type": "text/javascript" } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth","login"] }, "body": { "mode": "raw", "raw": "{\n  \"email\": \"teacher@lihiket.com\",\n  \"password\": \"Teacher@12345\"\n}" } }
