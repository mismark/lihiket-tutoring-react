          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{base_url}}/subjects", "host": ["{{base_url}}"], "path": ["subjects"] }, "body": { "mode": "raw", "raw": "{\n  \"name\": \"Mathematics\",\n  \"description\": \"Grade 12 Mathematics\",\n  \"gradeLevel\": \"G12\",\n  \"category\": \"Science\",\n  \"price\": 500\n}" } }
