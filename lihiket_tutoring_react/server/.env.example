# ─────────────────────────────────────────────────────────────────────────────
# Lihiket Tutoring Platform — Server Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/lihiket_tutoring
# Docker:  mongodb://mongo:27017/lihiket_tutoring
# Atlas:   mongodb+srv://user:pass@cluster.mongodb.net/lihiket_tutoring
MONGO_URI=mongodb://localhost:27017/lihiket_tutoring

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_long_random_secret_at_least_64_characters_long
JWT_EXPIRE=7d

# ── Client URL (your frontend domain) ────────────────────────────────────────
CLIENT_URL=https://yourdomain.com

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Gmail: use App Password (not your real password)
# Other: use your SMTP provider credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SENDER_EMAIL=noreply@yourdomain.com
SENDER_NAME=Lihiket Tutoring

# ── Chapa Payments ────────────────────────────────────────────────────────────
# Test key:  CHASECK_TEST-...  (fake money, for development)
# Live key:  CHASECK_LIVE-...  (real money, from dashboard.chapa.co after KYC)
CHAPA_SECRET_KEY=CHASECK_TEST-your_test_key_here

# Must be a public HTTPS URL — Chapa calls this after payment
# For local dev: use ngrok → ngrok http 5000 → copy the https URL
CHAPA_CALLBACK_URL=https://api.yourdomain.com/api/payments/webhook

# From Chapa dashboard → Webhooks → Webhook Secret
CHAPA_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ── File Uploads ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads
